# Copy to `.env` and fill in. Never commit real secrets.

# Quotai API host (no trailing slash). Local backend example: http://localhost:5001
VITE_QUOTAI_BASE_URL=https://quotai.net

# Project API key from Quotai project settings (format qk_...)
VITE_QUOTAI_API_KEY=qk_14bfc19469ca28d99407c6cfb72dadc467baa44651871cc104620c82ca3a9640

# Optional but recommended: MongoDB project id — validates the key matches this project and scopes localStorage cache
VITE_QUOTAI_PROJECT_ID=6a07b418316396fb7308c68f

# Refetch translations while the tab is open (ms). Default 60000. Set to 0 to disable live sync (initial load still uses Quotai).
VITE_QUOTAI_POLL_MS=60000
