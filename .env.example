# Copy to `.env` and fill in. Never commit real secrets.

# Quotai API host (no trailing slash). Local backend example: http://localhost:5001
VITE_QUOTAI_BASE_URL=https://quotai.net

# Project API key from Quotai project settings (format qk_...)
# When set: remote keys merge into src/locales/*.json — run `npm run locales` anytime (no build), or rely on `npm run build`.
# Env files: `.env` + `.env.production`; shell env vars override file values.
VITE_QUOTAI_API_KEY=

# Optional but recommended: MongoDB project id — validates the key matches this project and scopes localStorage cache
VITE_QUOTAI_PROJECT_ID=

# Refetch translations while the tab is open (ms). Default 60000. Set to 0 to disable live sync (initial load still uses Quotai).
VITE_QUOTAI_POLL_MS=60000

# Optional query params for GET /api/public/translations (see backend/API_DOCUMENTATION.md)
# VITE_QUOTAI_BRANCH_ID=
# VITE_QUOTAI_TRANSLATIONS_STATUS=
# VITE_QUOTAI_TRANSLATIONS_TAGS=
# VITE_QUOTAI_TRANSLATIONS_KEYS=
